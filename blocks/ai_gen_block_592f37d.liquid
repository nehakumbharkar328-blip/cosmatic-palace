{% doc %}
  @prompt
    Create an announcement bar (scrolling marquee) section for my Shopify store "Cosmetic Palace".
    
    DESIGN (match this reference: slim dark maroon strip, bold white text, round dot separators)
    - Full-width bar, height 40px desktop / 34px mobile
    - Background color: #5B1F3A (make it a color setting; maroon option #7A1426)
    - Text: white, font-weight 600, 14px desktop / 12.5px mobile, font-family inherits from the theme body font (Poppins)
    - Messages separated by a small round "•" dot in a lighter tint (white at 70% opacity), with about 40px spacing on each side
    - Text stays on one line (white-space: nowrap), vertically centered
    
    BEHAVIOR
    - Continuous, seamless right-to-left scrolling loop (CSS keyframes animation using translateX, no JavaScript jitter)
    - Duplicate the message group so the loop never shows a gap
    - Speed controlled by a setting (default 30s per loop)
    - Pause on hover
    - Respect prefers-reduced-motion (stop the animation and show the first message centered)
    - Optional: each message can be a link
    
    CONTENT (editable blocks in the Shopify theme editor, max 6)
    1. "Festive Sale: 27 to 31 Oct, ends 31 Oct 11:59 PM"
    2. "Up to 75% OFF On Top Brands"
    3. "100% Authentic Products"
    4. "Free Shipping above ₹999"
    (Repeat the messages so the bar always fills the screen width)
    
    SHOPIFY IMPLEMENTATION
    - Build it as a Shopify section file: sections/announcement-marquee.liquid
    - Include a {% schema %} with settings: background color, text color, speed (range 10 to 60s), font size, show/hide, pause on hover (checkbox)
    - Blocks: "message" with text and an optional link
    - Use scoped CSS inside the section (prefix classes with .cp-marquee-)
    - Make it sticky at the top above the header, and keep it lightweight (no external libraries)
    - Responsive and accessible: role="region", aria-label="Announcements", and a visually hidden static copy for screen readers, remove the side padding
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .cp-marquee-{{ ai_gen_id }} { display:block; position:sticky; top:0; z-index:20; width:100vw; max-width:none; margin-left:calc(50% - 50vw); height:40px; overflow:hidden; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; font-family:inherit; }
  .cp-marquee-{{ ai_gen_id }}[hidden] { display:none; }
  .cp-marquee-{{ ai_gen_id }} .cp-marquee__viewport { height:100%; display:flex; align-items:center; overflow:hidden; }
  .cp-marquee-{{ ai_gen_id }} .cp-marquee__track { display:flex; width:max-content; flex:0 0 auto; animation:cp-marquee-scroll-{{ ai_gen_id }} {{ block.settings.speed }}s linear infinite; }
  .cp-marquee-{{ ai_gen_id }} .cp-marquee__group { display:flex; flex:0 0 auto; align-items:center; white-space:nowrap; }
  .cp-marquee-{{ ai_gen_id }} .cp-marquee__item { display:inline-flex; align-items:center; color:inherit; font-size:{{ block.settings.font_size }}px; font-weight:600; line-height:1; text-decoration:none; white-space:nowrap; }
  .cp-marquee-{{ ai_gen_id }} .cp-marquee__dot { color:{{ block.settings.text_color }}; opacity:.7; padding:0 40px; font-size:14px; line-height:1; }
  .cp-marquee-{{ ai_gen_id }}[data-pause='true'] .cp-marquee__track:hover, .cp-marquee-{{ ai_gen_id }}:focus-within .cp-marquee__track { animation-play-state:paused; }
  @keyframes cp-marquee-scroll-{{ ai_gen_id }} { from { transform:translateX(0); } to { transform:translateX(-50%); } }
  .cp-marquee-{{ ai_gen_id }} .cp-marquee__static { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:normal; border:0; }
  @media (max-width:749px) { .cp-marquee-{{ ai_gen_id }} { height:34px; } .cp-marquee-{{ ai_gen_id }} .cp-marquee__item { font-size:12.5px; } }
  @media (prefers-reduced-motion:reduce) { .cp-marquee-{{ ai_gen_id }} .cp-marquee__track { animation:none; width:100%; justify-content:center; } .cp-marquee-{{ ai_gen_id }} .cp-marquee__group { display:none; } .cp-marquee-{{ ai_gen_id }} .cp-marquee__group:first-child { display:flex; justify-content:center; width:100%; } .cp-marquee-{{ ai_gen_id }} .cp-marquee__group:first-child .cp-marquee__item:not(:first-child), .cp-marquee-{{ ai_gen_id }} .cp-marquee__group:first-child .cp-marquee__item:not(:first-child) + .cp-marquee__dot { display:none; } }
{% endstyle %}
<div class="cp-marquee-{{ ai_gen_id }}" role="region" aria-label="Announcements" data-pause="{{ block.settings.pause_on_hover }}" {% unless block.settings.show_bar %}hidden{% endunless %} {{ block.shopify_attributes }}>
  {% assign message_count = 0 %}{% for i in (1..6) %}{% assign text_key = 'message_' | append: i %}{% assign text_value = block.settings[text_key] | strip %}{% if text_value != blank %}{% assign message_count = message_count | plus: 1 %}{% endif %}{% endfor %}
  <div class="cp-marquee__static" aria-live="off">{% for i in (1..6) %}{% assign text_key = 'message_' | append: i %}{% assign text_value = block.settings[text_key] | strip %}{% if text_value != blank %}{{ text_value | escape }}{% unless forloop.last %}. {% endunless %}{% endif %}{% endfor %}</div>
  <div class="cp-marquee__viewport" aria-hidden="true">{% if message_count > 0 %}<div class="cp-marquee__track">{% for copy in (1..2) %}<div class="cp-marquee__group">{% assign rendered = 0 %}{% for i in (1..6) %}{% assign text_key = 'message_' | append: i %}{% assign link_key = 'link_' | append: i %}{% assign text_value = block.settings[text_key] | strip %}{% if text_value != blank %}{% if rendered > 0 %}<span class="cp-marquee__dot">•</span>{% endif %}{% if block.settings[link_key] != blank %}<a class="cp-marquee__item" href="{{ block.settings[link_key] }}" tabindex="-1">{{ text_value | escape }}</a>{% else %}<span class="cp-marquee__item">{{ text_value | escape }}</span>{% endif %}{% assign rendered = rendered | plus: 1 %}{% endif %}{% endfor %}<span class="cp-marquee__dot">•</span></div>{% endfor %}</div>{% else %}<div class="cp-marquee__group"><span class="cp-marquee__item">Add announcement messages in block settings</span></div>{% endif %}</div>
</div>
{% schema %}
{
  "name": "Announcement marquee",
  "tag": null,
  "class": "cp-marquee-block",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show announcement bar", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#5B1F3A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 10, "max": 60, "step": 5, "unit": "s", "default": 30 },
    { "type": "range", "id": "font_size", "label": "Desktop font size", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Announcement 1" },
    { "type": "text", "id": "message_1", "label": "Message", "default": "Festive Sale: 27 to 31 Oct, ends 31 Oct 11:59 PM" },
    { "type": "url", "id": "link_1", "label": "Link" },
    { "type": "header", "content": "Announcement 2" },
    { "type": "text", "id": "message_2", "label": "Message", "default": "Up to 75% OFF On Top Brands" },
    { "type": "url", "id": "link_2", "label": "Link" },
    { "type": "header", "content": "Announcement 3" },
    { "type": "text", "id": "message_3", "label": "Message", "default": "100% Authentic Products" },
    { "type": "url", "id": "link_3", "label": "Link" },
    { "type": "header", "content": "Announcement 4" },
    { "type": "text", "id": "message_4", "label": "Message", "default": "Free Shipping above ₹999" },
    { "type": "url", "id": "link_4", "label": "Link" },
    { "type": "header", "content": "Announcement 5" },
    { "type": "text", "id": "message_5", "label": "Message" },
    { "type": "url", "id": "link_5", "label": "Link" },
    { "type": "header", "content": "Announcement 6" },
    { "type": "text", "id": "message_6", "label": "Message" },
    { "type": "url", "id": "link_6", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement marquee" }]
}
{% endschema %}